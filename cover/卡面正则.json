[
  {
    "id": "dpc-cover-mount",
    "scriptName": "[卡面]斗破封面",
    "findRegex": "/\\[DPC_COVER\\]/g",
    "replaceString": "<style>\n/* 斗破苍穹 · 卡面（封面 + 向导）\n   样式钩子全部用 data-* 属性：ST 消息楼层会给 class 加 custom- 前缀，\n   属性选择器不受影响，所以这份 CSS 在“正则渲染”和“脚本渲染”两条路上都成立。\n   配色改 [data-dpc] 上的四个变量即可。 */\n[data-dpc] {\n  --dpc-paper: #f7f2e7;\n  --dpc-ink: #2c2721;\n  --dpc-soft: #6a6157;\n  --dpc-line: #ddd2bf;\n  --dpc-accent: #8e3327;\n  box-sizing: border-box;\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  margin: 12px 0;\n  color: var(--dpc-ink);\n  font-family: \"Songti SC\", \"SimSun\", \"Noto Serif SC\", \"Source Han Serif SC\", Georgia, serif;\n  font-size: 15px;\n  line-height: 1.75;\n  text-align: left;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n[data-dpc] *, [data-dpc] *::before, [data-dpc] *::after { box-sizing: inherit; }\n/* 脚本用 hidden 属性收起 actions/read；下面 display:flex 这类规则会盖过\n   浏览器默认的 [hidden]{display:none}，这里必须显式压住。 */\n[data-dpc] [hidden] { display: none !important; }\n[data-dpc] [data-p=\"frame\"] {\n  max-width: 620px;\n  margin: 0 auto;\n  padding: 22px 20px 16px;\n  border: 1px solid var(--dpc-line);\n  border-radius: 2px;\n  background: var(--dpc-paper);\n}\n[data-dpc] [data-p=\"kicker\"] { margin: 0 0 10px; font-size: 11px; letter-spacing: .34em; color: var(--dpc-soft); }\n[data-dpc] [data-p=\"title\"] { margin: 0 0 6px; font-size: 27px; line-height: 1.25; font-weight: 600; letter-spacing: .16em; color: var(--dpc-ink); }\n[data-dpc] [data-p=\"sub\"] { margin: 0; font-size: 14px; letter-spacing: .04em; color: var(--dpc-soft); }\n[data-dpc] [data-p=\"rule\"] { position: relative; height: 1px; margin: 16px 0 18px; background: var(--dpc-line); }\n[data-dpc] [data-p=\"rule\"]::after { content: \"\"; position: absolute; left: 0; top: -1px; width: 46px; height: 3px; background: var(--dpc-accent); }\n[data-dpc] [data-p=\"sec\"] { margin: 0 0 18px; }\n[data-dpc] [data-p=\"sec\"]:last-child { margin-bottom: 0; }\n[data-dpc] [data-p=\"h\"] { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: .18em; color: var(--dpc-soft); }\n[data-dpc] [data-p=\"p\"] { margin: 0 0 10px; text-indent: 2em; }\n[data-dpc] [data-p=\"p\"]:last-child { margin-bottom: 0; }\n[data-dpc] [data-p=\"list\"] { margin: 0; padding: 0; list-style: none; }\n[data-dpc] [data-p=\"item\"] {\n  display: flex;\n  gap: 8px;\n  align-items: flex-start;\n  padding: 6px 0;\n  border-bottom: 1px dashed rgba(44, 39, 33, .12);\n}\n[data-dpc] [data-p=\"item\"]:last-child { border-bottom: none; }\n[data-dpc] [data-p=\"mark\"] { flex: 0 0 16px; text-align: center; font-size: 12px; line-height: 1.9; color: var(--dpc-soft); }\n[data-dpc] [data-state=\"ok\"] [data-p=\"mark\"] { color: #2f6b46; }\n[data-dpc] [data-state=\"warn\"] [data-p=\"mark\"] { color: var(--dpc-accent); }\n[data-dpc] [data-p=\"need\"] { flex: 1 1 auto; min-width: 0; }\n[data-dpc] [data-p=\"note\"] { display: block; font-size: 12px; line-height: 1.6; color: var(--dpc-soft); }\n[data-dpc] [data-p=\"actions\"] { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }\n[data-dpc] [data-p=\"btn\"] {\n  min-height: 44px;\n  padding: 0 18px;\n  border: 1px solid var(--dpc-ink);\n  border-radius: 2px;\n  background: transparent;\n  color: var(--dpc-ink);\n  font: inherit;\n  font-size: 15px;\n  letter-spacing: .06em;\n  cursor: pointer;\n}\n[data-dpc] [data-p=\"btn\"]:hover { background: rgba(44, 39, 33, .05); }\n[data-dpc] [data-p=\"btn\"][data-variant=\"primary\"] { background: var(--dpc-accent); border-color: var(--dpc-accent); color: #fdf8ef; }\n[data-dpc] [data-p=\"btn\"][data-variant=\"primary\"]:hover { background: #7a2b20; }\n[data-dpc] [data-p=\"btn\"]:focus-visible,\n[data-dpc] [data-p=\"link\"]:focus-visible,\n[data-dpc] [data-p=\"chip\"]:focus-visible { outline: 2px solid var(--dpc-accent); outline-offset: 2px; }\n[data-dpc] [data-p=\"btn\"][disabled] { opacity: .5; cursor: default; }\n[data-dpc] [data-p=\"link\"] {\n  min-height: 44px;\n  padding: 0 2px;\n  border: 0;\n  background: none;\n  color: var(--dpc-soft);\n  font: inherit;\n  font-size: 13px;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  cursor: pointer;\n}\n[data-dpc] [data-p=\"foot\"] { margin: 14px 0 0; font-size: 11px; letter-spacing: .08em; color: var(--dpc-soft); text-align: right; }\n/* 向导 */\n[data-dpc] [data-p=\"wiz\"] { margin: 2px 0 0; }\n[data-dpc] [data-p=\"steps\"] { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; font-size: 12px; color: var(--dpc-soft); }\n[data-dpc] [data-p=\"step\"] { padding: 2px 9px; border: 1px solid var(--dpc-line); border-radius: 999px; }\n[data-dpc] [data-p=\"step\"][data-on] { border-color: var(--dpc-accent); color: var(--dpc-accent); }\n[data-dpc] [data-p=\"field\"] { margin: 0 0 12px; }\n[data-dpc] [data-p=\"label\"] { display: block; margin-bottom: 6px; font-size: 13px; letter-spacing: .06em; color: var(--dpc-soft); }\n[data-dpc] [data-p=\"input\"],\n[data-dpc] [data-p=\"select\"],\n[data-dpc] [data-p=\"area\"] {\n  width: 100%;\n  min-height: 44px;\n  padding: 9px 10px;\n  border: 1px solid var(--dpc-line);\n  border-radius: 2px;\n  background: #fffdf7;\n  color: var(--dpc-ink);\n  font: inherit;\n  font-size: 15px;\n}\n[data-dpc] [data-p=\"area\"] { min-height: 88px; resize: vertical; line-height: 1.65; }\n[data-dpc] [data-p=\"chips\"] { display: flex; flex-wrap: wrap; gap: 8px; }\n[data-dpc] [data-p=\"chip\"] {\n  min-height: 40px;\n  padding: 0 14px;\n  border: 1px solid var(--dpc-line);\n  border-radius: 999px;\n  background: #fffdf7;\n  color: var(--dpc-ink);\n  font: inherit;\n  font-size: 14px;\n  cursor: pointer;\n}\n[data-dpc] [data-p=\"chip\"][aria-pressed=\"true\"] { border-color: var(--dpc-accent); background: #fbeee9; color: var(--dpc-accent); }\n[data-dpc] [data-p=\"row\"] { display: flex; flex-wrap: wrap; gap: 8px; }\n[data-dpc] [data-p=\"row\"] > * { flex: 1 1 140px; min-width: 0; }\n[data-dpc] [data-p=\"nav\"] { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }\n[data-dpc] [data-p=\"msg\"] { min-height: 20px; margin: 10px 0 0; font-size: 13px; color: var(--dpc-accent); }\n[data-dpc] [data-p=\"msg\"][data-tone=\"ok\"] { color: #2f6b46; }\n[data-dpc] [data-p=\"sum\"] { margin: 0; padding: 0; list-style: none; font-size: 14px; }\n[data-dpc] [data-p=\"sum\"] > li { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px dashed rgba(44, 39, 33, .12); }\n[data-dpc] [data-p=\"sum\"] > li:last-child { border-bottom: none; }\n[data-dpc] [data-p=\"sum\"] b { flex: 0 0 3.6em; font-weight: 400; color: var(--dpc-soft); }\n[data-dpc] [data-p=\"sum\"] span { flex: 1 1 auto; min-width: 0; white-space: pre-wrap; }\n@media (max-width: 430px) {\n  [data-dpc] [data-p=\"frame\"] { padding: 16px 14px 12px; }\n  [data-dpc] [data-p=\"title\"] { font-size: 22px; letter-spacing: .12em; }\n  [data-dpc] [data-p=\"kicker\"] { letter-spacing: .24em; }\n  [data-dpc] [data-p=\"p\"] { text-indent: 0; }\n  [data-dpc] [data-p=\"actions\"] > [data-p=\"btn\"] { flex: 1 1 100%; }\n}\n</style>\n<div data-dpc=\"cover\" data-dpc-version=\"1\">\n  <div data-p=\"frame\">\n    <p data-p=\"kicker\">同人 · 斗破苍穹</p>\n    <h2 data-p=\"title\">斗破苍穹</h2>\n    <p data-p=\"sub\">在这片大陆上，重新活一次。</p>\n    <div data-p=\"rule\"></div>\n    <div data-dpc-read>\n      <section data-p=\"sec\">\n        <p data-p=\"p\">斗气大陆没有魔法，只有斗气。从乌坦城的小家族，到中州的门阀与古族，所有的门都只为有实力的人开着。</p>\n        <p data-p=\"p\">你会带着不属于这个世界的记忆醒来，从一具少年人的身体开始。原著里的人各有各的路，他们不会停下来等你——你只是这片大陆上，多出来的一个变量。</p>\n      </section>\n      <section data-p=\"sec\">\n        <h3 data-p=\"h\">这一版会跟着你走的东西</h3>\n        <ul data-p=\"list\">\n          <li data-p=\"item\"><span data-p=\"mark\">·</span><span data-p=\"need\">背后有个 Agent 在记账：纳戒里的家当、人物簿里的关系、世界自己推进的事，都记在档上。</span></li>\n          <li data-p=\"item\"><span data-p=\"mark\">·</span><span data-p=\"need\">原著设定从资料库里查，不是凭印象编。</span></li>\n          <li data-p=\"item\"><span data-p=\"mark\">·</span><span data-p=\"need\">你可以给自己一个身份，顺便交代故事从哪一刻开始。</span></li>\n        </ul>\n      </section>\n      <section data-p=\"sec\">\n        <h3 data-p=\"h\">需要的东西</h3>\n        <ul data-p=\"list\" data-dpc-needs>\n          <li data-p=\"item\" data-need=\"client\"><span data-p=\"mark\">·</span><span data-p=\"need\">SillyTavern 1.18 及以上<span data-p=\"note\">版本太低时扩展清单不会加载</span></span></li>\n          <li data-p=\"item\" data-need=\"helper\"><span data-p=\"mark\">·</span><span data-p=\"need\">Tavern Helper（JS-Slash-Runner）<span data-p=\"note\">没装的话这张卡面只能看，点不动</span></span></li>\n          <li data-p=\"item\" data-need=\"bridge\"><span data-p=\"mark\">·</span><span data-p=\"need\">斗破同人 Agent 扩展（已启用）<span data-p=\"note\">纳戒、人物簿、世界台账都靠它</span></span></li>\n          <li data-p=\"item\" data-need=\"worldbook\"><span data-p=\"mark\">·</span><span data-p=\"need\">本卡的世界书（已导入并挂上）<span data-p=\"note\">没挂的话原著设定就查不到</span></span></li>\n          <li data-p=\"item\" data-need=\"model\"><span data-p=\"mark\">·</span><span data-p=\"need\">一个能用的模型连接<span data-p=\"note\">看右上角的连接状态</span></span></li>\n          <li data-p=\"item\" data-need=\"library\"><span data-p=\"mark\">·</span><span data-p=\"need\">剧情资料库（可选，后面再加）<span data-p=\"note\">不加也能玩，加了 Agent 查得更准</span></span></li>\n        </ul>\n      </section>\n    </div>\n    <div data-dpc-view hidden></div>\n    <div data-p=\"actions\" data-dpc-actions>\n      <button type=\"button\" data-p=\"btn\" data-variant=\"primary\" data-dpc-start>开始创建身份</button>\n      <button type=\"button\" data-p=\"link\" data-dpc-skip>先直接开始</button>\n    </div>\n    <p data-p=\"note\" data-dpc-boot>若这行字一直不消失：卡面脚本没接管，按钮点了不会有反应。去酒馆助手的脚本库确认这条脚本已启用、并绑定到本卡。</p>\n    <p data-p=\"msg\" data-dpc-msg aria-live=\"polite\"></p>\n    <p data-p=\"foot\">卡面 v0.1 · 正则 + 脚本</p>\n  </div>\n</div>",
